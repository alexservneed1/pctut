# --------------------------------------------------------------------
# «ПК ТУТ» — конфиг production-развёртывания.
# Скопируйте этот файл в `deploy/.env` и заполните значения.
#   cp deploy/.env.example deploy/.env
#   nano deploy/.env
# Файл `deploy/.env` НЕ должен попадать в git (см. deploy/.gitignore).
# Если этот шаблон в вашем репозитории называется `env.example` (без точки в начале) —
# это нормально: имя `.env.example` фильтруется Emergent push-агентом. Скопируйте так:
#   cp deploy/env.example deploy/.env
# --------------------------------------------------------------------

# ---------- MongoDB ----------
# Внутри docker-сети хост Mongo — 'mongo', порт 27017. Обычно менять не нужно.
MONGO_URL=mongodb://mongo:27017

# Имя базы данных (создаётся автоматически при первой записи).
DB_NAME=pktut

# ---------- Админ-панель ----------
# Токен для доступа к /admin и к защищённым API (/api/leads, PATCH /api/leads/{id}).
# ОБЯЗАТЕЛЬНО заменить на длинную случайную строку (минимум 24 символа).
# Пример генерации:  openssl rand -hex 24
ADMIN_TOKEN=

# ---------- CORS ----------
# Список разрешённых Origin через запятую. Указывайте домены с https://, без слэша в конце.
# Если сайт доступен только на одном домене — можно оставить только его.
CORS_ORIGINS=https://your-domain.ru,https://www.your-domain.ru

# ---------- VK-уведомления (опционально) ----------
# Если оба параметра ниже пусты — VK-уведомления просто не отправляются,
# заявки продолжают сохраняться в БД как обычно.
# Инструкция по получению — см. DEPLOY.md, раздел «Включение VK-уведомлений».
VK_TOKEN=
VK_PEER_ID=
VK_API_VERSION=5.199
