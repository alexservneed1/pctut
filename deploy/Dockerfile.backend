# Production Dockerfile для FastAPI backend «ПК ТУТ».
# Собирается из корня репозитория:
#   docker build -f deploy/Dockerfile.backend -t pktut-backend .
FROM python:3.11-slim

# Не буферизуем stdout — логи сразу в docker logs.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Системные зависимости, необходимые части пакетов из requirements.txt (pandas/numpy и т.п.).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Ставим зависимости отдельным слоем — кэш при следующих сборках.
COPY backend/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt

# Копируем исходники backend'а.
COPY backend/ ./

EXPOSE 8001

# Healthcheck — простая проверка живости API.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8001/api/health || exit 1

# uvicorn с одним воркером — для VDS 2 ГБ RAM этого достаточно.
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
