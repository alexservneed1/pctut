# Multi-stage Dockerfile для React frontend + nginx.
# Собирается из корня репозитория:
#   docker build -f deploy/Dockerfile.frontend -t pktut-frontend .
#
# Внимание: REACT_APP_BACKEND_URL здесь НЕ задаётся — фронт в проде обращается
# к тому же домену через относительный путь /api (fallback на window.location.origin,
# см. /app/frontend/src/lib/api.js), а nginx проксирует /api → backend:8001.

# ---------- Stage 1: build ----------
FROM node:20-alpine AS builder
WORKDIR /app

# Ставим зависимости отдельным слоем для кэша.
# Внимание: используется `yarn-lock-deploy` (копия yarn.lock) вместо `yarn.lock`,
# т.к. Emergent push-агент фильтрует именно 'yarn.lock' при пуше в GitHub.
COPY frontend/package.json ./package.json
COPY frontend/yarn-lock-deploy ./yarn.lock
RUN yarn install --frozen-lockfile --network-timeout 600000

# Исходники и сборка.
COPY frontend/ ./
# Явно снимаем возможные dev-значения — фронт в проде работает same-origin.
ENV REACT_APP_BACKEND_URL="" \
    NODE_OPTIONS="--max-old-space-size=1024" \
    GENERATE_SOURCEMAP=false \
    CI=false
RUN yarn build

# ---------- Stage 2: serve ----------
FROM nginx:alpine
# Свой конфиг.
RUN rm /etc/nginx/conf.d/default.conf
COPY deploy/nginx.conf /etc/nginx/conf.d/pktut.conf
# Статика.
COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
